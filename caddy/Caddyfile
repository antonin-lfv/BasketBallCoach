# Remplace :80 par ton domaine (ex. basketballcoach.fr) pour activer
# automatiquement le HTTPS Let's Encrypt.
{$SITE_ADDRESS::80} {
	encode gzip

	# API -> FastAPI
	handle /api/* {
		reverse_proxy api:8000
	}

	# Application React (SPA : toute route /app/* retombe sur l'index du build)
	handle_path /app/* {
		root * /srv/app
		try_files {path} /index.html
		file_server
	}
	redir /app /app/ permanent

	# Landing statique à la racine
	handle {
		root * /srv/landing
		file_server
	}
}
