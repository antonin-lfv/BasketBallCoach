# Copie ce fichier en .env puis remplis les valeurs

# Mot de passe PostgreSQL (production)
POSTGRES_PASSWORD=change-moi

# Ton domaine pour le HTTPS automatique (laisser :80 pour tester sans domaine)
SITE_ADDRESS=:80

# Ports publiés sur la machine hôte.
# Si "port is already allocated" : mets par exemple 8080 et 8443.
HTTP_PORT=80
HTTPS_PORT=443
